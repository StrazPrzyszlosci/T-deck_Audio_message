index 0000000..e3c98ad
--- /dev/null
+++ b/src/modules/esp32/voice/VoiceModule.cpp
@@ -0,0 +1,886 @@
+#include "configuration.h"
+#if defined(ARCH_ESP32) && defined(T_DECK) && !MESHTASTIC_EXCLUDE_AUDIO && !MESHTASTIC_EXCLUDE_VOICE
+
+#include "VoiceModule.h"
+
+#include "FSCommon.h"
+#include "MeshService.h"
+#include "NodeDB.h"
+#include "Router.h"
+#include "Throttle.h"
+#include "UptimeClock.h"
+#include "main.h"
+#include "meshUtils.h"
+
+#include "codec2/codec2.h"
+#include "tdeck_audio.h"
+
+#include <esp_heap_caps.h>
+#include <esp_random.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+#include <stdarg.h>
+
+#if HAS_SCREEN
+#include "graphics/Screen.h"
+#endif
+
+VoiceModule *voiceModule;
+
+// ---- worker task state ------------------------------------------------
+
+enum VoiceTaskState { VOICE_TASK_IDLE, VOICE_TASK_RECORD, VOICE_TASK_FINISH };
+
+static volatile VoiceTaskState taskState = VOICE_TASK_IDLE;
+static volatile bool recordStopRequested = false;
+static int16_t *recordBuffer = NULL; // PSRAM, VOICE_MAX_SECONDS * 8000 samples
+static size_t recordSamples = 0;
+static size_t recordTargetSamples = 0;
+
+// TX geometry mirrored for the static worker task
+static uint16_t g_samplesPerFrame = VOICE_SAMPLES_PER_FRAME_40MS;
+
+#define VOICE_STREAM_MAX_BYTES ((VOICE_MAX_SECONDS * 50 * 64) / 8 + 64) // 10 s of 64-bit frames + slack
+static uint8_t encodeStream[VOICE_STREAM_MAX_BYTES];
+static uint8_t encodeFrame[8];
+
+static bool voiceModeGeometry(uint8_t mode, uint16_t *bits, uint16_t *samples)
+{
+    switch (mode) {
+    case 0: // 3200
+    case 1: // 2400
+    case 2: // 1600
+    case 4: // 1300
+    case 5: // 1200
+        *bits = (mode == 2) ? 40 : (mode == 4) ? 52 : (mode == 0) ? 64 : 48;
+        *samples = VOICE_SAMPLES_PER_FRAME_40MS;
+        return true;
+    case 3: // 1400
+        *bits = 56;
+        *samples = VOICE_SAMPLES_PER_FRAME_40MS;
+        return true;
+    case 8: // 700C
+        *bits = 28;
+        *samples = 160;
+        return true;
+    default:
+        return false;
+    }
+}
+
+// ES7210 PGA gain register 0x10..0x1E is not a linear scale:
+// +3 dB steps up to 33 dB, then +1.5 dB steps (datasheet / reticulum-tdeck).
+static const uint16_t voiceGainTenthsDb[15] = {0,   30,  60,  90,  120, 150, 180, 210,
+                                               240, 270, 300, 330, 345, 360, 375};
+static uint8_t voiceRegFromDbTenths(uint16_t tenths)
+{
+    uint8_t best = 0;
+    uint16_t bestErr = 0xFFFF;
+    for (uint8_t i = 0; i < 15; i++) {
+        uint16_t err = (voiceGainTenthsDb[i] > tenths) ? voiceGainTenthsDb[i] - tenths : tenths - voiceGainTenthsDb[i];
+        if (err < bestErr) {
+            bestErr = err;
+            best = i;
+        }
+    }
+    return (uint8_t)(0x10 + best);
+}
+
+static uint8_t modeFromBitrate(meshtastic_ModuleConfig_AudioConfig_Audio_Baud baud)
+{
+    switch (baud) {
+    case meshtastic_ModuleConfig_AudioConfig_Audio_Baud_CODEC2_3200:
+        return 0;
+    case meshtastic_ModuleConfig_AudioConfig_Audio_Baud_CODEC2_2400:
+        return 1;
+    case meshtastic_ModuleConfig_AudioConfig_Audio_Baud_CODEC2_1600:
+        return 2;
+    case meshtastic_ModuleConfig_AudioConfig_Audio_Baud_CODEC2_1400:
+        return 3;
+    case meshtastic_ModuleConfig_AudioConfig_Audio_Baud_CODEC2_1200:
+        return 5;
+    case meshtastic_ModuleConfig_AudioConfig_Audio_Baud_CODEC2_700C:
+        return 8;
+    case meshtastic_ModuleConfig_AudioConfig_Audio_Baud_CODEC2_700:
+    case meshtastic_ModuleConfig_AudioConfig_Audio_Baud_CODEC2_700B:
+        return VOICE_MODE_DEFAULT; // removed from libcodec2 upstream
+    default:
+        return VOICE_MODE_DEFAULT;
+    }
+}
+
+static const char *modeName(uint8_t mode)
+{
+    switch (mode) {
+    case 0:
+        return "3200";
+    case 1:
+        return "2400";
+    case 2:
+        return "1600";
+    case 3:
+        return "1400";
+    case 4:
+        return "1300";
+    case 5:
+        return "1200";
+    case 8:
+        return "700C";
+    }
+    return "?";
+}
+
+static void voiceWorkerTask(void *param)
+{
+    (void)param;
+    int16_t drain[64];
+    while (true) {
+        if (taskState == VOICE_TASK_RECORD) {
+            while (recordSamples < recordTargetSamples && !recordStopRequested) {
+                size_t chunk = recordTargetSamples - recordSamples;
+                if (chunk > g_samplesPerFrame)
+                    chunk = g_samplesPerFrame;
+                if (!tdeckaudio::micRead(recordBuffer + recordSamples, chunk))
+                    break;
+                recordSamples += chunk;
+            }
+            taskState = VOICE_TASK_FINISH;
+        } else if (taskState == VOICE_TASK_FINISH) {
+            size_t frames = (recordSamples + g_samplesPerFrame - 1) / g_samplesPerFrame;
+            if (frames * g_samplesPerFrame > recordSamples)
+                memset(recordBuffer + recordSamples, 0,
+                       (frames * g_samplesPerFrame - recordSamples) * sizeof(int16_t));
+            voiceModule->sendEncoded(frames);
+            taskState = VOICE_TASK_IDLE;
+        } else {
+            // keep the ES7210 clocked and its DMA consumed while idle (the ADC
+            // needs sustained active reads after power-up or it stops producing)
+            tdeckaudio::micRead(drain, sizeof(drain) / sizeof(drain[0]));
+            vTaskDelay(pdMS_TO_TICKS(2));
+        }
+    }
+}
+
+// ---- frame bitstream helpers -------------------------------------------
+
+static void frameBitsAppend(uint8_t *stream, size_t &bitPos, const uint8_t *frame, uint16_t bitsPerFrame)
+{
+    for (int i = 0; i < bitsPerFrame; i++) {
+        uint8_t bit = (frame[i >> 3] >> (7 - (i & 7))) & 1;
+        if (bit) {
+            size_t p = bitPos + i;
+            stream[p >> 3] |= (1 << (7 - (p & 7)));
+        }
+    }
+    bitPos += bitsPerFrame;
+}
+
+static void frameBitsExtract(const uint8_t *stream, size_t frameStartBit, uint8_t *frame, uint16_t bitsPerFrame)
+{
+    memset(frame, 0, 8);
+    for (int i = 0; i < bitsPerFrame; i++) {
+        size_t p = frameStartBit + i;
+        uint8_t bit = (stream[p >> 3] >> (7 - (p & 7))) & 1;
+        if (bit)
+            frame[i >> 3] |= (1 << (7 - (i & 7)));
+    }
+}
+
+static void chunkBitsCopyIn(uint8_t *dst, size_t dstBit, const uint8_t *src, size_t nbits)
+{
+    for (size_t i = 0; i < nbits; i++) {
+        uint8_t bit = (src[i >> 3] >> (7 - (i & 7))) & 1;
+        size_t p = dstBit + i;
+        if (bit)
+            dst[p >> 3] |= (1 << (7 - (p & 7)));
+        else
+            dst[p >> 3] &= (uint8_t) ~(1 << (7 - (p & 7)));
+    }
+}
+
+// ---- playback task ------------------------------------------------------
+
+void VoiceModule::playbackTask(void *param)
+{
+    VoiceModule *self = (VoiceModule *)param;
+    size_t totalFrames = self->rxTotalFrames;
+    uint32_t mask = self->rxMask;
+    uint8_t framesPerChunk = self->rxFramesPerChunk;
+    uint16_t bitsPerFrame = self->rxBitsPerFrame;
+    uint16_t samplesPerFrame = self->rxSamplesPerFrame;
+    uint8_t volume = self->playVolume;
+    uint8_t frameBuf[8];
+    static int16_t speech[320];
+    static int16_t silence[320] = {0};
+
+    if (!tdeckaudio::initSpeaker()) {
+        LOG_ERROR("Voice: speaker init failed");
+        self->vlog("speaker init failed");
+        self->rxPlaying = false;
+        vTaskDelete(NULL);
+        return;
+    }
+
+    for (size_t f = 0; f < totalFrames; f++) {
+        size_t chunk = f / framesPerChunk;
+        if (chunk < VOICE_RX_MAX_CHUNKS && (mask & (1UL << chunk))) {
+            frameBitsExtract(self->rxStream, f * bitsPerFrame, frameBuf, bitsPerFrame);
+            codec2_decode(self->decCodec2, speech, frameBuf);
+            if (volume != VOICE_PLAYBACK_GAIN_MAX) {
+                for (int i = 0; i < samplesPerFrame; i++) {
+                    int32_t v = ((int32_t)speech[i] * volume) / VOICE_PLAYBACK_GAIN_MAX;
+                    speech[i] = (int16_t)v;
+                }
+            }
+            tdeckaudio::speakerWrite(speech, samplesPerFrame);
+        } else {
+            tdeckaudio::speakerWrite(silence, samplesPerFrame);
+        }
+    }
+
+    // let the last samples drain, then stop the clock so the amp mutes
+    vTaskDelay(pdMS_TO_TICKS(100));
+    tdeckaudio::speakerStop();
+    self->rxPlaying = false;
+    self->vlog("playback done %u frames", (unsigned)totalFrames);
+    vTaskDelete(NULL);
+}
+
+// ---- module -------------------------------------------------------------
+
+VoiceModule::VoiceModule() : SinglePortModule("voice", meshtastic_PortNum_AUDIO_APP), concurrency::OSThread("voice")
+{
+    if (moduleConfig.audio.codec2_enabled) {
+        if (inputBroker)
+            inputObserver.observe(inputBroker);
+
+        loadSettings();
+        tdeckaudio::setMicGain(micGainReg);
+
+        txMode = moduleConfig.audio.bitrate ? modeFromBitrate(moduleConfig.audio.bitrate) : VOICE_MODE_DEFAULT;
+        applyTxMode(txMode);
+        LOG_INFO("Voice: codec2 %s bps, gain reg 0x%02x, volume %u/16", modeName(txMode), micGainReg, playVolume);
+    } else {
+        disable();
+    }
+}
+
+void VoiceModule::applyTxMode(uint8_t mode)
+{
+    uint16_t bits, samples;
+    if (!voiceModeGeometry(mode, &bits, &samples))
+        mode = VOICE_MODE_DEFAULT;
+
+    struct CODEC2 *enc = codec2_create(mode);
+    if (!enc) {
+        LOG_ERROR("Voice: codec2_create(%u) failed", mode);
+        if (!encCodec2)
+            disable();
+        return;
+    }
+    if (encCodec2)
+        codec2_destroy(encCodec2);
+    encCodec2 = enc;
+    txMode = mode;
+    codec2_set_lpc_post_filter(encCodec2, 1, 0, 0.8, 0.2);
+
+    if (decCodec2 == NULL || decMode != mode) {
+        struct CODEC2 *dec = codec2_create(mode);
+        if (dec) {
+            if (decCodec2)
+                codec2_destroy(decCodec2);
+            decCodec2 = dec;
+            decMode = mode;
+            codec2_set_lpc_post_filter(decCodec2, 1, 0, 0.8, 0.2);
+        }
+    }
+
+    bitsPerFrame = bits;
+    samplesPerFrame = samples;
+    g_samplesPerFrame = samples;
+    framesPerChunk = (VOICE_PAYLOAD_BUDGET * 8) / bits;
+    if (bits % 8)
+        framesPerChunk &= (uint8_t)~1; // keep chunk payloads byte aligned
+    if (framesPerChunk == 0)
+        framesPerChunk = 2;
+
+    LOG_INFO("Voice: tx mode %s (%u b/frame, %u samples, %u frames/chunk)", modeName(mode), bits, samples, framesPerChunk);
+}
+
+void VoiceModule::vlog(const char *format, ...)
+{
+    if (!loggingEnabled)
+        return;
+    char line[96];
+    va_list ap;
+    va_start(ap, format);
+    int n = vsnprintf(line, sizeof(line), format, ap);
+    va_end(ap);
+    if (n < 0)
+        return;
+    LOG_INFO("Voice: %s", line);
+
+    char entry[112];
+    int m = snprintf(entry, sizeof(entry), "[%lu] %s\n", (unsigned long)Time::getMillis(), line);
+    if (m <= 0)
+        return;
+    if ((size_t)m > sizeof(entry))
+        m = sizeof(entry);
+    if (logLen + m > sizeof(logRing)) {
+        uint16_t keep = sizeof(logRing) / 2;
+        memmove(logRing, logRing + logLen - keep, keep);
+        logLen = keep;
+    }
+    if (logLen + m <= sizeof(logRing)) {
+        memcpy(logRing + logLen, entry, m);
+        logLen += m;
+        logRing[logLen] = 0;
+    }
+}
+
+void VoiceModule::loadSettings()
+{
+    if (settingsLoaded)
+        return;
+    settingsLoaded = true;
+    if (!FSBegin())
+        return;
+    auto f = FSCom.open("/voice.cfg", FILE_O_READ);
+    if (!f)
+        return;
+    int g = -1, v = -1, l = -1;
+    int parsed = sscanf(f.readStringUntil('\n').c_str(), "g=%d v=%d l=%d", &g, &v, &l);
+    f.close();
+    if (parsed >= 1 && g >= 0x10 && g <= 0x1E)
+        micGainReg = (uint8_t)g;
+    if (parsed >= 2 && v >= 0 && v <= VOICE_PLAYBACK_GAIN_MAX)
+        playVolume = (uint8_t)v;
+    if (parsed >= 3)
+        loggingEnabled = (l != 0);
+}
+
+void VoiceModule::saveSettings()
+{
+    if (!FSBegin())
+        return;
+    auto f = FSCom.open("/voice.cfg", FILE_O_WRITE);
+    if (!f)
+        return;
+    f.printf("g=%u v=%u l=%u\n", micGainReg, playVolume, loggingEnabled ? 1 : 0);
+    f.close();
+}
+
+void VoiceModule::sendText(const char *text, NodeNum to, uint8_t channel)
+{
+    meshtastic_MeshPacket *p = router->allocForSending();
+    if (!p)
+        return;
+    p->to = to;
+    p->channel = channel;
+    p->decoded.portnum = meshtastic_PortNum_TEXT_MESSAGE_APP;
+    size_t n = strlen(text);
+    if (n > meshtastic_Constants_DATA_PAYLOAD_LEN)
+        n = meshtastic_Constants_DATA_PAYLOAD_LEN;
+    memcpy(p->decoded.payload.bytes, text, n);
+    p->decoded.payload.size = n;
+    p->priority = meshtastic_MeshPacket_Priority_RELIABLE;
+    service->sendToMesh(p);
+}
+
+void VoiceModule::pumpLogSend()
+{
+    if (!logSendPending)
+        return;
+    if (logSendDest == NODENUM_BROADCAST) {
+        logSendPending = false;
+        sendText("voice: logsend only as a direct message, please resend as DM", logSendDest, logSendChannel);
+        return;
+    }
+    if (logSendPos >= logLen) {
+        logSendPending = false;
+        sendText("--- end of voice log ---", logSendDest, logSendChannel);
+        return;
+    }
+    char line[200];
+    uint16_t n = 0;
+    while (logSendPos < logLen && n < sizeof(line) - 1 && logRing[logSendPos] != '\n')
+        line[n++] = logRing[logSendPos++];
+    if (logSendPos < logLen)
+        logSendPos++; // skip newline
+    line[n] = 0;
+    if (n > 0)
+        sendText(line, logSendDest, logSendChannel);
+}
+
+bool VoiceModule::interceptLocalVoiceCommand(meshtastic_MeshPacket *p)
+{
+    if (!p || p->which_payload_variant != meshtastic_MeshPacket_decoded_tag)
+        return false;
+    if (p->decoded.portnum != meshtastic_PortNum_TEXT_MESSAGE_APP)
+        return false;
+
+    const uint8_t *b = p->decoded.payload.bytes;
+    size_t n = p->decoded.payload.size;
+    const char *cmd = VOICE_TRIGGER_CMD;
+    size_t cmdLen = strlen(cmd);
+    if (n < cmdLen)
+        return false;
+    for (size_t i = 0; i < cmdLen; i++) {
+        char c = (b[i] >= 'A' && b[i] <= 'Z') ? b[i] + 32 : b[i];
+        if (c != cmd[i])
+            return false;
+    }
+
+    // argument parsing
+    uint8_t seconds = VOICE_MAX_SECONDS;
+    char arg[16] = {0};
+    if (n > cmdLen) {
+        if (n > cmdLen + sizeof(arg) || b[cmdLen] != ' ')
+            return false;
+        memcpy(arg, b + cmdLen + 1, n - cmdLen - 1);
+        arg[n - cmdLen - 1] = 0;
+    }
+
+    if (arg[0] == 0) {
+        // plain countdown recording
+    } else if (!strcmp(arg, "ptt")) {
+        if (taskState != VOICE_TASK_IDLE || pendingTrigger || pttArmed)
+            return false;
+        pttArmed = true;
+        pttReleaseCount = 0;
+        pttRecording = false;
+        pttDest = p->to;
+        pttChannel = p->channel;
+        pttDeadlineMs = Time::getMillis() + VOICE_PTT_ARM_TIMEOUT_MS;
+        vlog("ptt armed dest 0x%x", p->to);
+        IF_SCREEN(screen->showSimpleBanner("PTT ready:\nhold trackball", 4000);)
+        LOG_INFO("Voice: PTT armed (dest 0x%x)", p->to);
+        return true;
+    } else if (!strncmp(arg, "gain ", 5)) {
+        int db = atoi(arg + 5);
+        if (db < 0 || db > 38)
+            return false;
+        micGainReg = voiceRegFromDbTenths((uint16_t)(db * 10));
+        tdeckaudio::setMicGain(micGainReg);
+        saveSettings();
+        uint16_t tenths = voiceGainTenthsDb[micGainReg - 0x10];
+        vlog("mic gain %u.%u dB (reg 0x%02x)", tenths / 10, tenths % 10, micGainReg);
+        char buf[48];
+        snprintf(buf, sizeof(buf), "voice: mic gain %u.%u dB", tenths / 10, tenths % 10);
+        sendText(buf, p->to, p->channel);
+        return true;
+    } else if (!strncmp(arg, "vol ", 4)) {
+        int v = atoi(arg + 4);
+        if (v < 0 || v > VOICE_PLAYBACK_GAIN_MAX)
+            return false;
+        playVolume = (uint8_t)v;
+        saveSettings();
+        vlog("playback volume %u/16", playVolume);
+        char buf[48];
+        snprintf(buf, sizeof(buf), "voice: playback volume %u/16", playVolume);
+        sendText(buf, p->to, p->channel);
+        return true;
+    } else if (!strcmp(arg, "log on") || !strcmp(arg, "log off")) {
+        loggingEnabled = (arg[5] == 'n');
+        saveSettings();
+        if (loggingEnabled)
+            vlog("logging enabled");
+        sendText(loggingEnabled ? "voice: logging on" : "voice: logging off", p->to, p->channel);
+        return true;
+    } else if (!strcmp(arg, "logsend")) {
+        if (logSendPending)
+            return true;
+        logSendPending = true;
+        logSendPos = 0;
+        logSendDest = p->to;
+        logSendChannel = p->channel;
+        vlog("logsend to 0x%x", p->to);
+        return true;
+    } else if (!strcmp(arg, "status")) {
+        uint16_t tenths = voiceGainTenthsDb[micGainReg - 0x10];
+        char buf[160];
+        snprintf(buf, sizeof(buf), "voice: mode %s, gain %u.%u dB, vol %u/16, log %s, mic %s", modeName(txMode),
+                 tenths / 10, tenths % 10, playVolume, loggingEnabled ? "on" : "off",
+                 tdeckaudio::micAlive() ? "ok" : "warm-up");
+        sendText(buf, p->to, p->channel);
+        return true;
+    } else {
+        // optional seconds argument for the countdown recording
+        uint8_t v = 0;
+        for (size_t i = 0; arg[i]; i++) {
+            if (arg[i] < '0' || arg[i] > '9')
+                return false;
+            v = (uint8_t)(v * 10 + (arg[i] - '0'));
+        }
+        if (v < 1 || v > VOICE_MAX_SECONDS)
+            return false;
+        seconds = v;
+    }
+
+    if (taskState != VOICE_TASK_IDLE || pendingTrigger || pttArmed)
+        return false;
+
+    pendingSeconds = seconds;
+    pendingDest = p->to;
+    pendingChannel = p->channel;
+    pendingTrigger = true;
+    vlog("trigger %u s dest 0x%x", seconds, p->to);
+    return true;
+}
+
+int VoiceModule::handleInputEvent(const InputEvent *event)
+{
+    if (pttArmed) {
+        // the trackball center is the PTT key; other keys leave PTT mode
+        if (event->inputEvent == INPUT_BROKER_SELECT)
+            return 0;
+        pttArmed = false;
+        vlog("ptt exited by key");
+        IF_SCREEN(screen->showSimpleBanner("PTT off", 2000);)
+        return 0;
+    }
+    if (taskState == VOICE_TASK_RECORD && recordStopRequested == false) {
+        LOG_INFO("Voice: key pressed, stopping recording early");
+        recordStopRequested = true;
+    }
+    return 0;
+}
+
+void VoiceModule::startRecording(uint8_t seconds)
+{
+    if (!recordBuffer) {
+        recordBuffer = (int16_t *)heap_caps_malloc(VOICE_MAX_SECONDS * VOICE_PCM_RATE_HZ * sizeof(int16_t),
+                                                   MALLOC_CAP_SPIRAM);
+        if (!recordBuffer) {
+            LOG_ERROR("Voice: PSRAM alloc failed");
+            vlog("psram alloc failed");
+            IF_SCREEN(screen->showSimpleBanner("Voice:\nno memory", 3000);)
+            return;
+        }
+    }
+    if (!micInitialized)
+        micInitialized = tdeckaudio::initMic();
+    if (!micInitialized) {
+        LOG_ERROR("Voice: mic unavailable");
+        vlog("mic init failed");
+        IF_SCREEN(screen->showSimpleBanner("Voice:\nmic init failed", 3000);)
+        return;
+    }
+    recordSamples = 0;
+    recordTargetSamples = (size_t)seconds * VOICE_PCM_RATE_HZ;
+    recordStopRequested = false;
+    taskState = VOICE_TASK_RECORD;
+}
+
+void VoiceModule::sendEncoded(size_t frames)
+{
+    if (!encCodec2 || frames == 0)
+        return;
+
+    uint32_t t0 = Time::getMillis();
+    size_t bitPos = 0;
+    for (size_t f = 0; f < frames; f++) {
+        codec2_encode(encCodec2, encodeFrame, recordBuffer + f * samplesPerFrame);
+        frameBitsAppend(encodeStream, bitPos, encodeFrame, bitsPerFrame);
+    }
+    uint32_t tEncode = Time::getMillis() - t0;
+
+    size_t chunkCount = (frames + framesPerChunk - 1) / framesPerChunk;
+    if (chunkCount > VOICE_MAX_CHUNKS)
+        chunkCount = VOICE_MAX_CHUNKS;
+    uint8_t msgId = (uint8_t)((esp_random() & 0xFF) | 1);
+
+    vlog("encoded %u frames in %lu ms, sending %u chunks", (unsigned)frames, (unsigned long)tEncode,
+         (unsigned)chunkCount);
+
+    for (size_t k = 0; k < chunkCount; k++) {
+        size_t framesInChunk = (k == chunkCount - 1) ? frames - k * framesPerChunk : framesPerChunk;
+        size_t payloadBits = framesInChunk * bitsPerFrame;
+        size_t payloadBytes = (payloadBits + 7) / 8;
+        size_t chunkBytes = framesPerChunk * bitsPerFrame / 8;
+
+        meshtastic_MeshPacket *p = allocDataPacket();
+        if (!p)
+            return;
+        p->to = activeDest;
+        p->channel = activeChannel;
+        p->want_ack = false;
+        p->priority = meshtastic_MeshPacket_Priority_HIGH;
+
+        p->decoded.payload.size = VOICE_HEADER_SIZE + payloadBytes;
+        uint8_t *out = p->decoded.payload.bytes;
+        out[0] = VOICE_MAGIC0;
+        out[1] = VOICE_MAGIC1;
+        out[2] = msgId;
+        out[3] = txMode;
+        out[4] = (uint8_t)k;
+        out[5] = (uint8_t)chunkCount;
+        out[6] = framesPerChunk;
+        out[7] = 0;
+        memcpy(out + VOICE_HEADER_SIZE, encodeStream + k * chunkBytes, payloadBytes);
+
+        service->sendToMesh(p);
+
+        if (k + 1 < chunkCount)
+            vTaskDelay(pdMS_TO_TICKS(VOICE_TX_PACING_MS));
+    }
+
+    vlog("send complete %u chunks", (unsigned)chunkCount);
+    IF_SCREEN(screen->showSimpleBanner("Voice message\nsent", 3000);)
+}
+
+ProcessMessage VoiceModule::handleReceived(const meshtastic_MeshPacket &mp)
+{
+    if (moduleConfig.audio.codec2_enabled && !isFromUs(&mp)) {
+        auto &d = mp.decoded;
+        if (d.payload.size > VOICE_HEADER_SIZE && d.payload.size <= meshtastic_Constants_DATA_PAYLOAD_LEN)
+            handleVoiceChunk(d.payload.bytes, d.payload.size, getFrom(&mp));
+    }
+    return ProcessMessage::CONTINUE;
+}
+
+void VoiceModule::handleVoiceChunk(const uint8_t *payload, size_t len, NodeNum from)
+{
+    if (rxPlaying) {
+        LOG_WARN("Voice: dropping chunk, busy playing");
+        return;
+    }
+    if (payload[0] != VOICE_MAGIC0 || payload[1] != VOICE_MAGIC1)
+        return;
+
+    uint16_t rxBits, rxSamples;
+    if (!voiceModeGeometry(payload[3], &rxBits, &rxSamples)) {
+        LOG_WARN("Voice: unsupported codec2 mode %u", payload[3]);
+        return;
+    }
+    uint8_t chunkIdx = payload[4], chunkCount = payload[5], framesPerChunk = payload[6];
+    if (framesPerChunk == 0 || framesPerChunk > 64 || chunkCount == 0 || chunkCount > VOICE_RX_MAX_CHUNKS)
+        return;
+    if (chunkIdx >= chunkCount)
+        return;
+    // a message claiming more frames than the reassembly buffer can hold must
+    // never enter the slot: the timeout path derives its playback length from
+    // these header fields and would otherwise read past rxStream
+    if ((size_t)framesPerChunk * (chunkCount - 1) >= VOICE_RX_MAX_FRAMES)
+        return;
+
+    size_t payloadBits = (len - VOICE_HEADER_SIZE) * 8;
+    size_t framesInChunk = payloadBits / rxBits;
+    if (framesInChunk == 0 || payloadBits % rxBits != 0)
+        return;
+    bool isLast = (chunkIdx == chunkCount - 1);
+    if (!isLast && framesInChunk != framesPerChunk)
+        return;
+    if (isLast && framesInChunk > framesPerChunk)
+        return;
+
+    size_t totalFrames = isLast ? (size_t)framesPerChunk * (chunkCount - 1) + framesInChunk : SIZE_MAX;
+    if (totalFrames != SIZE_MAX && totalFrames > VOICE_RX_MAX_FRAMES)
+        return;
+
+    if (rxMsgId != payload[2] || rxChunkCount != chunkCount || rxFramesPerChunk != framesPerChunk || rxMode != payload[3] ||
+        !rxHasData) {
+        if (rxHasData)
+            LOG_WARN("Voice: switching to newer message");
+        memset(rxStream, 0, sizeof(rxStream));
+        rxMask = 0;
+        rxMsgId = payload[2];
+        rxChunkCount = chunkCount;
+        rxFramesPerChunk = framesPerChunk;
+        rxMode = payload[3];
+        rxBitsPerFrame = rxBits;
+        rxSamplesPerFrame = rxSamples;
+        rxTotalFrames = 0;
+        rxHaveTotal = false;
+        rxHasData = true;
+        rxLastUpdateMs = Time::getMillis();
+        rxDeadlineMs = rxLastUpdateMs + VOICE_REASSEMBLY_TIMEOUT_MS;
+        vlog("rx msg 0x%x mode %s %u chunks", from, modeName(rxMode), chunkCount);
+    }
+
+    size_t dstBit = (size_t)chunkIdx * framesPerChunk * rxBitsPerFrame;
+    if (dstBit / 8 + (framesInChunk * rxBitsPerFrame + 7) / 8 > sizeof(rxStream))
+        return;
+    chunkBitsCopyIn(rxStream, dstBit, payload + VOICE_HEADER_SIZE, framesInChunk * rxBitsPerFrame);
+    rxMask |= (1UL << chunkIdx);
+    rxLastUpdateMs = Time::getMillis();
+    rxDeadlineMs = rxLastUpdateMs + VOICE_REASSEMBLY_TIMEOUT_MS;
+
+    if (isLast) {
+        rxTotalFrames = (size_t)framesPerChunk * (chunkCount - 1) + framesInChunk;
+        rxHaveTotal = true;
+    }
+
+    uint32_t allMask = (chunkCount >= 32) ? 0xFFFFFFFFUL : ((1UL << chunkCount) - 1);
+    if ((rxMask & allMask) == allMask && rxHaveTotal) {
+        startPlayback();
+        rxHasData = false;
+    }
+}
+
+void VoiceModule::startPlayback()
+{
+    if (!decCodec2 || rxTotalFrames == 0)
+        return;
+    if (decMode != rxMode) {
+        struct CODEC2 *dec = codec2_create(rxMode);
+        if (dec) {
+            codec2_destroy(decCodec2);
+            decCodec2 = dec;
+            decMode = rxMode;
+            codec2_set_lpc_post_filter(decCodec2, 1, 0, 0.8, 0.2);
+        }
+    }
+    rxPlaying = true;
+    uint32_t missing = rxChunkCount - __builtin_popcount(rxMask);
+    vlog("playback %u frames, %u chunks missing", (unsigned)rxTotalFrames, (unsigned)missing);
+    IF_SCREEN(screen->showSimpleBanner("Voice message\nreceived", 3000);)
+    if (xTaskCreate(playbackTask, "voice_play", 8192, this, 4, NULL) != pdPASS) {
+        rxPlaying = false;
+        LOG_ERROR("Voice: playback task create failed");
+    }
+}
+
+int32_t VoiceModule::runOnce()
+{
+    if (!moduleConfig.audio.codec2_enabled)
+        return disable();
+
+    if (!selfTestDone) {
+        selfTestDone = true;
+        runSelfTest();
+        if (myRegion && myRegion->profile && !myRegion->profile->audioPermitted)
+            LOG_WARN("Voice: region code %d disallows audio in upstream firmware; this fork enables recorded voice "
+                     "messages - respect local duty cycle rules",
+                     (int)config.lora.region);
+    }
+
+    // live bitrate changes from the app take effect without a reboot
+    uint8_t wantedMode = moduleConfig.audio.bitrate ? modeFromBitrate(moduleConfig.audio.bitrate) : VOICE_MODE_DEFAULT;
+    if (wantedMode != txMode && taskState == VOICE_TASK_IDLE && !rxPlaying) {
+        applyTxMode(wantedMode);
+        vlog("tx mode -> %s", modeName(txMode));
+    }
+
+    // PTT session: hold the trackball center (GPIO0) to record
+    if (pttArmed && Throttle::deadlinePassed(pttDeadlineMs)) {
+        pttArmed = false;
+        vlog("ptt timeout");
+        IF_SCREEN(screen->showSimpleBanner("PTT off", 2000);)
+    }
+    if (pttArmed) {
+        bool pressed = digitalRead(TB_PRESS) == LOW;
+        if (pressed && !pttRecording && taskState == VOICE_TASK_IDLE) {
+            pttRecording = true;
+            pttReleaseCount = 0;
+            activeDest = pttDest;
+            activeChannel = pttChannel;
+            vlog("ptt record start");
+            startRecording(VOICE_MAX_SECONDS);
+            IF_SCREEN(screen->showSimpleBanner("PTT: speak\nrelease to send", 1000);)
+        } else if (pttRecording && !pressed) {
+            if (++pttReleaseCount >= 2) { // ~100 ms debounce
+                recordStopRequested = true;
+                vlog("ptt release, sending");
+            }
+        } else if (pttRecording && pressed) {
+            pttReleaseCount = 0;
+        }
+    }
+    if (pttRecording && taskState == VOICE_TASK_IDLE) {
+        pttRecording = false;
+        pttDeadlineMs = Time::getMillis() + VOICE_PTT_ARM_TIMEOUT_MS; // stay armed for another round
+    }
+
+    if (pendingTrigger) {
+        pendingTrigger = false;
+        if (taskState == VOICE_TASK_IDLE && !pttArmed) {
+            activeDest = pendingDest;
+            activeChannel = pendingChannel;
+            startRecording(pendingSeconds);
+            vlog("recording %u s", pendingSeconds);
+            IF_SCREEN(screen->showSimpleBanner("Recording...\nany key = stop", 1500);)
+        }
+    }
+
+    if (taskState == VOICE_TASK_RECORD && !pttRecording) {
+        static uint32_t lastProgressMs = 0;
+        if (Throttle::hasElapsed(lastProgressMs, 1000)) {
+            size_t left = (recordTargetSamples - recordSamples) / VOICE_PCM_RATE_HZ;
+            char buf[32];
+            snprintf(buf, sizeof(buf), "Recording...\n%u s, key = stop", (unsigned)left);
+            IF_SCREEN(screen->showSimpleBanner(buf, 1500);)
+        }
+    }
+
+    if (rxHasData && !rxPlaying && Throttle::deadlinePassed(rxDeadlineMs)) {
+        // incomplete message: play whatever arrived, missing chunks stay silent
+        if (!rxHaveTotal) {
+            rxTotalFrames = (size_t)rxFramesPerChunk * (rxChunkCount - 1);
+            rxHaveTotal = true;
+        }
+        if (rxTotalFrames > VOICE_RX_MAX_FRAMES)
+            rxTotalFrames = VOICE_RX_MAX_FRAMES;
+        LOG_WARN("Voice: reassembly timed out, playing partial (%u/%u chunks)", __builtin_popcount(rxMask),
+                 rxChunkCount);
+        vlog("rx timeout, partial %u/%u", __builtin_popcount(rxMask), rxChunkCount);
+        startPlayback();
+        IF_SCREEN(screen->showSimpleBanner("Partial voice\nmessage", 3000);)
+        rxHasData = false;
+    }
+
+    pumpLogSend();
+
+    // Power, clock and drain the ES7210 from boot: the ADC needs sustained
+    // active I2S reads after power-up, otherwise the first recording is silent.
+    if (!micInitialized) {
+        micInitialized = tdeckaudio::initMic();
+        if (micInitialized) {
+            tdeckaudio::setMicGain(micGainReg);
+            LOG_INFO("Voice: ES7210 mic online");
+        } else {
+            LOG_ERROR("Voice: ES7210 init failed");
+        }
+    }
+    static bool workerStarted = false;
+    if (!workerStarted && micInitialized) {
+        if (xTaskCreate(voiceWorkerTask, "voice_worker", 30000, NULL, 3, NULL) == pdPASS)
+            workerStarted = true;
+        else
+            LOG_ERROR("Voice: worker task create failed");
+    }
+
+    return (pttArmed || pttRecording || taskState != VOICE_TASK_IDLE || logSendPending) ? 50 : 200;
+}
+
+bool VoiceModule::runSelfTest()
+{
+    if (!encCodec2 || !decCodec2)
+        return false;
+
+    int16_t in[320];
+    for (int i = 0; i < samplesPerFrame && i < 320; i++) {
+        float t = (float)i / 8000.0f;
+        in[i] = (int16_t)(2500 * sinf(6.2831855f * 300 * t) + 1200 * sinf(6.2831855f * 1200 * t) +
+                          800 * sinf(6.2831855f * 2100 * t) + (esp_random() % 400 - 200));
+    }
+    int16_t out[320];
+    uint32_t t0 = Time::getMillis();
+    codec2_encode(encCodec2, encodeFrame, in);
+    uint32_t tEnc = Time::getMillis() - t0;
+    t0 = Time::getMillis();
+    codec2_decode(decCodec2, out, encodeFrame);
+    uint32_t tDec = Time::getMillis() - t0;
+
+    int32_t energy = 0;
+    for (int i = 0; i < samplesPerFrame; i++)
+        energy += abs(out[i]);
+    bool ok = energy > 5000 && tEnc < 4000;
+    vlog("self-test %s enc %lu ms dec %lu ms energy %ld", ok ? "ok" : "FAILED", (unsigned long)tEnc,
+         (unsigned long)tDec, (long)energy);
+    if (!ok)
+        LOG_ERROR("Voice: self-test FAILED - audio may be silent/garbled");
+    return ok;
+}
+
+#endif
diff --git a/src/modules/esp32/voice/VoiceModule.h b/src/modules/esp32/voice/VoiceModule.h
new file mode 100644
index 0000000..0caacd6
--- /dev/null
+++ b/src/modules/esp32/voice/VoiceModule.h
@@ -0,0 +1,147 @@
+#pragma once
+
+#include "configuration.h"
+#if defined(ARCH_ESP32) && defined(T_DECK) && !MESHTASTIC_EXCLUDE_AUDIO && !MESHTASTIC_EXCLUDE_VOICE
+#define TDECK_VOICE_MODULE 1
+
+#include "SinglePortModule.h"
+#include "concurrency/OSThread.h"
+#include "input/InputBroker.h"
+
+#include <stdint.h>
+#include <stddef.h>
+
+// Recorded Codec2 voice messages for the LilyGO T-Deck (SX1262), fork feature.
+// Wire format (meshtastic_PortNum_AUDIO_APP payloads, 8 byte header):
+//   [0]=0x56 [1]=0x4D [2]=msgId [3]=codec2 mode (0,1,2,3,4,5,8)
+//   [4]=chunkIdx [5]=chunkCount [6]=framesPerChunk [7]=flags(0)
+//   followed by framesPerChunk Codec2 frames as a continuous bitstream.
+// Frame geometry comes from the codec2 mode (3200/2400/1600/1400/1300/1200:
+// 320 samples, 700C: 160 samples); chunk payloads are byte aligned.
+
+#define VOICE_MAGIC0 0x56
+#define VOICE_MAGIC1 0x4D
+#define VOICE_HEADER_SIZE 8
+
+#define VOICE_MODE_DEFAULT 4 // CODEC2_MODE_1300 (52 bits / 320 samples)
+#define VOICE_SAMPLES_PER_FRAME_40MS 320
+#define VOICE_FRAMES_PER_SECOND_25 25
+
+#define VOICE_MAX_SECONDS 10
+#define VOICE_PCM_RATE_HZ 8000
+
+#define VOICE_PAYLOAD_BUDGET (meshtastic_Constants_DATA_PAYLOAD_LEN - VOICE_HEADER_SIZE) // 225
+
+#define VOICE_MAX_CHUNKS 10
+#define VOICE_RX_MAX_CHUNKS 32
+#define VOICE_TX_PACING_MS 1000 // >= 1 packet of airtime on ShortSlow per chunk
+#define VOICE_REASSEMBLY_TIMEOUT_MS 90000
+#define VOICE_PTT_ARM_TIMEOUT_MS 60000
+#define VOICE_TRIGGER_CMD "!voice"
+
+#define VOICE_RX_MAX_FRAMES 512
+#define VOICE_RX_STREAM_BYTES ((VOICE_RX_MAX_FRAMES * 64) / 8) // sized for the widest frame
+
+#define VOICE_LOG_RING_BYTES 3072
+#define VOICE_PLAYBACK_GAIN_MAX 16
+
+class VoiceModule : public SinglePortModule, private concurrency::OSThread
+{
+    CallbackObserver<VoiceModule, const InputEvent *> inputObserver =
+        CallbackObserver<VoiceModule, const InputEvent *>(this, &VoiceModule::handleInputEvent);
+
+  public:
+    VoiceModule();
+
+    // Called from MeshService::sendToMesh for locally originated packets.
+    // Consumes "!voice ..." text packets before they reach the mesh.
+    bool interceptLocalVoiceCommand(meshtastic_MeshPacket *p);
+
+    int handleInputEvent(const InputEvent *event);
+
+    // Called by the voice worker task; allocDataPacket() needs the module instance
+    void sendEncoded(size_t frames);
+
+  protected:
+    virtual int32_t runOnce() override;
+    virtual ProcessMessage handleReceived(const meshtastic_MeshPacket &mp) override;
+
+  private:
+    void startRecording(uint8_t seconds);
+    void handleVoiceChunk(const uint8_t *payload, size_t len, NodeNum from);
+    void startPlayback();
+    bool runSelfTest();
+    static void playbackTask(void *param);
+
+    void applyTxMode(uint8_t mode);
+    void sendText(const char *text, NodeNum to, uint8_t channel);
+    void vlog(const char *format, ...);
+    void loadSettings();
+    void saveSettings();
+    void pumpLogSend();
+
+    struct CODEC2 *encCodec2 = NULL;
+    struct CODEC2 *decCodec2 = NULL;
+    uint8_t decMode = 0xFF;
+
+    // TX geometry, derived from the codec2 mode
+    uint8_t txMode = VOICE_MODE_DEFAULT;
+    uint16_t bitsPerFrame = 52;
+    uint16_t samplesPerFrame = VOICE_SAMPLES_PER_FRAME_40MS;
+    uint8_t framesPerChunk = 34;
+
+    // RX geometry of the message currently being reassembled
+    uint16_t rxBitsPerFrame = 52;
+    uint16_t rxSamplesPerFrame = VOICE_SAMPLES_PER_FRAME_40MS;
+
+    // persisted settings (voice.cfg on LittleFS)
+    uint8_t micGainReg = 0x1E; // ES7210 PGA: 0x10 = 0 dB .. 0x1E = 37.5 dB
+    uint8_t playVolume = VOICE_PLAYBACK_GAIN_MAX;
+    bool loggingEnabled = true;
+    bool settingsLoaded = false;
+
+    bool micInitialized = false;
+    bool selfTestDone = false;
+
+    // trigger state (set from API threads, consumed by runOnce)
+    volatile bool pendingTrigger = false;
+    uint8_t pendingSeconds = VOICE_MAX_SECONDS;
+    NodeNum pendingDest = 0;
+    uint8_t pendingChannel = 0;
+    NodeNum activeDest = 0;
+    uint8_t activeChannel = 0;
+
+    // PTT (hold the trackball center to talk)
+    volatile bool pttArmed = false;
+    bool pttRecording = false;
+    NodeNum pttDest = 0;
+    uint8_t pttChannel = 0;
+    uint32_t pttDeadlineMs = 0;
+    uint8_t pttReleaseCount = 0;
+
+    // log ring + deferred log dump
+    char logRing[VOICE_LOG_RING_BYTES];
+    uint16_t logLen = 0;
+    bool logSendPending = false;
+    uint16_t logSendPos = 0;
+    NodeNum logSendDest = 0;
+    uint8_t logSendChannel = 0;
+
+    // reassembly state (single slot; v1)
+    uint8_t rxStream[VOICE_RX_STREAM_BYTES] = {};
+    uint32_t rxMask = 0;
+    uint8_t rxMsgId = 0;
+    uint8_t rxChunkCount = 0;
+    uint8_t rxFramesPerChunk = 0;
+    uint8_t rxMode = 0;
+    size_t rxTotalFrames = 0;
+    bool rxHaveTotal = false;
+    bool rxHasData = false;
+    bool rxPlaying = false;
+    uint32_t rxLastUpdateMs = 0;
+    uint32_t rxDeadlineMs = 0;
+};
+
+extern VoiceModule *voiceModule;
+
+#endif
