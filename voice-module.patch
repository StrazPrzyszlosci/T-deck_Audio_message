index 0000000..2d0b383
--- /dev/null
+++ b/src/modules/esp32/voice/codec2/pack.c
@@ -0,0 +1,142 @@
+#if defined(T_DECK) && !defined(MESHTASTIC_EXCLUDE_AUDIO)
+/*
+  Copyright (C) 2010 Perens LLC <bruce@perens.com>
+
+  All rights reserved.
+
