+#if defined(T_DECK) && !defined(MESHTASTIC_EXCLUDE_AUDIO)
+/*---------------------------------------------------------------------------*\
+
+  FILE........: newamp1.c
+  AUTHOR......: David Rowe
+  DATE CREATED: Jan 2017
+
+  Quantisation functions for the sinusoidal coder, using "newamp1"
+  algorithm that resamples variable rate L [Am} to a fixed rate K then
+  VQs.
+
+\*---------------------------------------------------------------------------*/
+
+/*
