diff --git a/src/modules/esp32/voice/tdeck_audio.cpp b/src/modules/esp32/voice/tdeck_audio.cpp
new file mode 100644
index 0000000..8056fcf
--- /dev/null
+++ b/src/modules/esp32/voice/tdeck_audio.cpp
@@ -0,0 +1,256 @@
+#include "configuration.h"
+#if defined(ARCH_ESP32) && defined(T_DECK) && !MESHTASTIC_EXCLUDE_AUDIO && !MESHTASTIC_EXCLUDE_VOICE
+
+#include "tdeck_audio.h"
+
+#include <Wire.h>
+#include <driver/i2s.h>
+
+// variant.h on t-deck
+#ifndef ES7210_SCK
+#define ES7210_SCK 47
+#endif
+#ifndef ES7210_WS
+#define ES7210_WS 21
+#endif
+#ifndef ES7210_DIN
+#define ES7210_DIN 14
+#endif
+#ifndef ES7210_MCLK
+#define ES7210_MCLK 48
+#endif
+#ifndef DAC_I2S_BCK
+#define DAC_I2S_BCK 7
+#endif
+#ifndef DAC_I2S_WS
+#define DAC_I2S_WS 5
+#endif
+#ifndef DAC_I2S_DOUT
+#define DAC_I2S_DOUT 6
+#endif
+
+namespace tdeckaudio {
+
+static bool micInstalled = false;
+static bool spkInstalled = false;
+static bool micIsAlive = false;
+static uint8_t micGainReg = VOICE_ES7210_GAIN;
+
+static bool esWrite(uint8_t reg, uint8_t val)
+{
+    Wire.beginTransmission(VOICE_ES7210_ADDR);
+    Wire.write(reg);
+    Wire.write(val);
+    return Wire.endTransmission() == 0;
+}
+
+void setMicGain(uint8_t reg)
+{
+    if (reg < 0x10)
+        reg = 0x10;
+    if (reg > 0x1E)
+        reg = 0x1E;
+    micGainReg = reg;
+    if (!micInstalled)
+        return;
+    for (uint8_t r = 0x43; r <= 0x46; r++)
+        esWrite(r, micGainReg);
+}
+
+bool initMic()
+{
+    if (micInstalled)
+        return true;
+
+    // Register sequence from the hardware-verified reticulum-tdeck driver,
+    // with LRCK rate mode 1 (their measured correction for a true 16 kHz stream)
+    if (!esWrite(0x00, 0xFF))
+        return false;
+    delay(50);
+    esWrite(0x00, 0x32);
+    delay(20);
+
+    esWrite(0x01, 0x1F); // clocks off during configuration
+    esWrite(0x09, 0x30);
+    esWrite(0x0A, 0x30);
+    esWrite(0x23, 0x2A); // digital HPF, removes DC
+    esWrite(0x22, 0x0A);
+    esWrite(0x21, 0x2A);
+    esWrite(0x20, 0x0A);
+    esWrite(0x11, 0x60); // I2S, 16 bit
+    esWrite(0x12, 0x00); // non-TDM: ADC1/2 on SDOUT1 (mic is ADC1 = left)
+    esWrite(0x40, 0xC3); // analog power + VMID
+    esWrite(0x41, 0x70); // mic bias 2.87 V
+    esWrite(0x42, 0x70);
+    for (uint8_t r = 0x43; r <= 0x46; r++)
+        esWrite(r, micGainReg);
+    for (uint8_t r = 0x47; r <= 0x4A; r++)
+        esWrite(r, 0x00); // power on mic inputs
+    esWrite(0x07, 0x20);  // OSR
+    esWrite(0x02, 0xC1);  // ADC clock doubler + DLL
+    esWrite(0x04, 0x01);  // LRCK divider 256: 4.096 MHz MCLK -> 16 kHz
+    esWrite(0x05, 0x00);
+    esWrite(0x06, 0x04);  // DLL power down
+    esWrite(0x4B, 0x0F);  // power up ADC + PGA
+    esWrite(0x4C, 0x0F);
+    esWrite(0x08, 0x10);  // slave mode, LRCK rate mode 1
+    esWrite(0x03, 0x04);  // MCLK from pin
+    esWrite(0x00, 0x71);
+    delay(10);
+    esWrite(0x00, 0x41);
+    delay(10);
+    esWrite(0x01, 0x00); // start clocks
+    delay(100);
+
+    i2s_config_t cfg = {.mode = (i2s_mode_t)(I2S_MODE_MASTER | I2S_MODE_RX),
+                        .sample_rate = VOICE_MIC_NATIVE_RATE_HZ,
+                        .bits_per_sample = I2S_BITS_PER_SAMPLE_16BIT,
+                        .channel_format = I2S_CHANNEL_FMT_RIGHT_LEFT,
+                        .communication_format = I2S_COMM_FORMAT_STAND_I2S,
+                        .intr_alloc_flags = ESP_INTR_FLAG_LEVEL1,
+                        .dma_buf_count = 8,
+                        .dma_buf_len = 512,
+                        .use_apll = false,
+                        .tx_desc_auto_clear = false,
+                        .fixed_mclk = 0};
+    if (i2s_driver_install(VOICE_MIC_I2S_PORT, &cfg, 0, NULL) != ESP_OK)
+        return false;
+
+    i2s_pin_config_t pins = {.mck_io_num = ES7210_MCLK,
+                             .bck_io_num = ES7210_SCK,
+                             .ws_io_num = ES7210_WS,
+                             .data_out_num = I2S_PIN_NO_CHANGE,
+                             .data_in_num = ES7210_DIN};
+    if (i2s_set_pin(VOICE_MIC_I2S_PORT, &pins) != ESP_OK)
+        return false;
+    i2s_zero_dma_buffer(VOICE_MIC_I2S_PORT);
+
+    micInstalled = true;
+    micIsAlive = false;
+    return true;
+}
+
+bool micRead(int16_t *out, size_t samples)
+{
+    if (!micInstalled)
+        return false;
+
+    // Read stereo 16 kHz and decimate x2 -> 8 kHz mono (left channel holds the mic).
+    static int16_t p1 = 0, p2 = 0, p3 = 0; // LPF state over consecutive 16 kHz samples
+    static uint8_t toggle = 0;
+    static int16_t raw[2 * 256];
+    size_t done = 0;
+    while (done < samples) {
+        size_t want = samples - done;
+        size_t block = (want > 128) ? 128 : want; // mono out per read; 2 stereo pairs in per out
+        size_t bytesRead = 0;
+        if (i2s_read(VOICE_MIC_I2S_PORT, raw, block * 8, &bytesRead, pdMS_TO_TICKS(200)) != ESP_OK)
+            return false;
+        if (bytesRead == 0)
+            continue;
+        size_t pairsIn = bytesRead / 4;
+        for (size_t i = 0; i < pairsIn && done < samples; i++) {
+            int16_t l = raw[2 * i]; // left channel = ADC1 = onboard mic
+            if (l != 0)
+                micIsAlive = true;
+            if (toggle == 0) {
+                // 4-sample box low-pass before the 2:1 decimation
+                int32_t v = ((int32_t)l + p1 + p2 + p3) / 4;
+                out[done++] = (int16_t)v;
+            }
+            toggle ^= 1;
+            p3 = p2;
+            p2 = p1;
+            p1 = l;
+        }
+    }
+    return true;
+}
+
+bool micReady()
+{
+    return micInstalled;
+}
+
+bool micAlive()
+{
+    return micIsAlive;
+}
+
+void micDeinit()
+{
+    if (micInstalled) {
+        i2s_driver_uninstall(VOICE_MIC_I2S_PORT);
+        micInstalled = false;
+    }
+}
+
+bool initSpeaker()
+{
+    if (spkInstalled)
+        return true;
+
+    i2s_config_t cfg = {.mode = (i2s_mode_t)(I2S_MODE_MASTER | I2S_MODE_TX),
+                        .sample_rate = VOICE_PCM_RATE_HZ,
+                        .bits_per_sample = I2S_BITS_PER_SAMPLE_16BIT,
+                        .channel_format = I2S_CHANNEL_FMT_RIGHT_LEFT,
+                        .communication_format = I2S_COMM_FORMAT_STAND_I2S,
+                        .intr_alloc_flags = ESP_INTR_FLAG_LEVEL1,
+                        .dma_buf_count = 8,
+                        .dma_buf_len = 512,
+                        .use_apll = false,
+                        .tx_desc_auto_clear = true,
+                        .fixed_mclk = 0};
+    if (i2s_driver_install(VOICE_SPK_I2S_PORT, &cfg, 0, NULL) != ESP_OK)
+        return false;
+
+    i2s_pin_config_t pins = {.mck_io_num = I2S_PIN_NO_CHANGE,
+                            .bck_io_num = DAC_I2S_BCK,
+                            .ws_io_num = DAC_I2S_WS,
+                            .data_out_num = DAC_I2S_DOUT,
+                            .data_in_num = I2S_PIN_NO_CHANGE};
+    if (i2s_set_pin(VOICE_SPK_I2S_PORT, &pins) != ESP_OK)
+        return false;
+    i2s_zero_dma_buffer(VOICE_SPK_I2S_PORT);
+
+    spkInstalled = true;
+    return true;
+}
+
+bool speakerWrite(const int16_t *samples, size_t count)
+{
+    if (!spkInstalled)
+        return false;
+    static int16_t dup[2 * 256];
+    size_t done = 0;
+    while (done < count) {
+        size_t block = (count - done > 256) ? 256 : (count - done);
+        for (size_t i = 0; i < block; i++) {
+            dup[2 * i] = samples[done + i];
+            dup[2 * i + 1] = samples[done + i]; // MAX98357A sums L+R
+        }
+        size_t written = 0;
+        if (i2s_write(VOICE_SPK_I2S_PORT, dup, block * 4, &written, pdMS_TO_TICKS(500)) != ESP_OK || written != block * 4)
+            return false;
+        done += block;
+    }
+    return true;
+}
+
+void speakerStop()
+{
+    if (spkInstalled)
+        i2s_stop(VOICE_SPK_I2S_PORT);
+}
+
+void speakerDeinit()
+{
+    if (spkInstalled) {
+        i2s_driver_uninstall(VOICE_SPK_I2S_PORT);
+        spkInstalled = false;
+    }
+}
+
+} // namespace tdeckaudio
+
+#endif
